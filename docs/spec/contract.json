          "type": [
            "string",
            "null"
          ]
        },
        "svn_revision": {
          "type": [
            "string",
            "null"
          ]
        },
        "readiness": {
          "type": "object",
          "required": [
            "status",
            "embeddings",
            "reasons"
          ],
          "properties": {
            "status": {
              "enum": [
                "missing_graph",
                "building",
                "rebuild_required",
                "partial_index",
                "stale_graph",
                "stale_worktree",
                "ok"
              ]
            },
            "embeddings": {
              "enum": [
                "off",
                "ready",
                "stale",
                "unavailable"
              ]
            },
            "reasons": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "schema_version": {
          "type": "integer"
        },
        "index_generation": {
          "type": [
            "integer",
            "null"
          ]
        },
        "contract_version": {
          "type": "string"
        },
        "source_identity": {
